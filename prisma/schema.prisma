// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String   @id @default(uuid())
  username        String   @unique
  password        String   // Hashed password
  role            Role     @default(USER)
  
  // Profile info
  displayName     String?
  avatarUrl       String?

  // If role is ADMIN (Chef)
  chefCode        String?  @unique
  
  // If role is USER (Guest)
  connectedChefId String?
  connectedChef   User?    @relation("ChefToGuest", fields: [connectedChefId], references: [id])
  guests          User[]   @relation("ChefToGuest")

  menuItems       MenuItem[]
  orders          Order[]

  guestDishRequests DishRequest[] @relation("GuestDishRequests")
  chefDishRequests  DishRequest[] @relation("ChefDishRequests")
}

enum Role {
  ADMIN
  USER
}

model MenuItem {
  id                  String   @id @default(uuid())
  name                String
  description         String?
  imageUrl            String?
  category            Category
  isAvailableThisWeek Boolean  @default(false)
  isFavorite          Boolean  @default(false)
  
  chefId              String
  chef                User     @relation(fields: [chefId], references: [id], onDelete: Cascade)
  
  orders              Order[]
}

enum Category {
  MAIN
  SIDE
  DRINK
  DESSERT
}

model Order {
  id         String      @id @default(uuid())
  menuItemId String
  menuItem   MenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  
  guestId    String
  guest      User        @relation(fields: [guestId], references: [id], onDelete: Cascade)
  
  date       DateTime    @default(now())
  targetDate DateTime    @default(now())
  status     OrderStatus @default(PENDING)
  notes      String?
  chefNote   String?
  review     Review?
}

enum OrderStatus {
  PENDING
  COOKING
  READY
  COMPLETED
}

model Review {
  id       String  @id @default(uuid())
  orderId  String  @unique
  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rating   Int     // 1 to 5
  feedback String?
}

model DishRequest {
  id        String   @id @default(uuid())
  guestId   String
  guest     User     @relation("GuestDishRequests", fields: [guestId], references: [id], onDelete: Cascade)
  chefId    String
  chef      User     @relation("ChefDishRequests", fields: [chefId], references: [id], onDelete: Cascade)
  
  dishName  String
  notes     String?
  replyNote String?
  status    DishRequestStatus @default(PENDING)
  createdAt DateTime @default(now())
}

enum DishRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}
